{
  "name": "verible-extension",
  "description": "Verible - Trust Analysis for Marketplace Sellers. Make safer purchasing decisions with real-time seller trust scores.",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "npm run generate-types && wxt",
    "dev:firefox": "npm run generate-types && wxt -b firefox",
    "build": "npm run generate-types && wxt build",
    "build:firefox": "npm run generate-types && wxt build -b firefox",
    "zip": "npm run generate-types && wxt zip",
    "zip:firefox": "npm run generate-types && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "generate-types": "tsx scripts/generate-types.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/module-react": "^1.1.3",
    "openapi-typescript": "^7.10.1",
    "postman-to-openapi": "^1.7.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "wxt": "^0.20.6"
  }
}
